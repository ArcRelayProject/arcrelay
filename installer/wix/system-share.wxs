<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <Component Id="ArcRelaySystemShareRegistry" Guid="*">
        <RegistryKey Root="HKCU" Key="Software\Classes\*\shell\ArcRelay.Share" Action="createAndRemoveOnUninstall">
          <RegistryValue Type="string" Value="Share with ArcRelay" KeyPath="yes" />
          <RegistryValue Type="string" Name="MUIVerb" Value="Share with ArcRelay" />
          <RegistryValue Type="string" Name="Icon" Value="[INSTALLDIR]arcrelay-desktop.exe,0" />
          <RegistryValue Type="string" Name="MultiSelectModel" Value="Player" />
          <RegistryValue Type="string" Name="Position" Value="Top" />
          <RegistryKey Key="command" Action="createAndRemoveOnUninstall">
            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]arcrelay-desktop.exe&quot; --arcrelay-share-source windows-context-menu --arcrelay-share &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <CustomAction
      Id="RegisterArcRelaySystemShare"
      Directory="INSTALLDIR"
      ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]system-share\windows\register-sparse-package.ps1&quot; -ExternalLocation &quot;[INSTALLDIR]&quot; -PackagePath &quot;[INSTALLDIR]system-share\windows\ArcRelay.SystemShare.msix&quot;"
      Execute="immediate"
      Return="ignore"
      Impersonate="yes" />
    <CustomAction
      Id="UnregisterArcRelaySystemShare"
      Directory="INSTALLDIR"
      ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]system-share\windows\unregister-sparse-package.ps1&quot;"
      Execute="immediate"
      Return="ignore"
      Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="RegisterArcRelaySystemShare" After="InstallFiles">NOT REMOVE</Custom>
      <Custom Action="UnregisterArcRelaySystemShare" Before="RemoveFiles">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
